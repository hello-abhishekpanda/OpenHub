@page "/settings"
@inject HttpClient Http
<PageTitle>Settings — OpenHub</PageTitle>
<div class="page-head"><div><span class="eyebrow">PLATFORM CONFIGURATION</span><h1>GitHub connection</h1><p>Validate server-side credentials and review API capacity.</p></div></div>
<div class="settings-grid"><section class="settings-card"><div class="setting-icon">⌁</div><div><h2>GitHub REST API</h2><p>The token is loaded securely from server configuration and is never returned to this browser.</p></div><button class="primary" disabled="@testing" @onclick="Test">@(testing ? "Testing…" : "Test API connection")</button></section>
@if (status is not null) { <section class="connection-result @(status.Connected ? "success" : "failure")"><strong>@(status.Connected ? "Connection healthy" : "Connection failed")</strong><p>@(status.Connected ? $"Authenticated as @{status.Login}. {status.Remaining:N0} of {status.Limit:N0} requests remain." : status.Error)</p>@if(status.ResetAt is not null){<small>Rate limit resets @status.ResetAt.Value.ToLocalTime().ToString("dd MMM, HH:mm")</small>}</section> }
<section class="settings-card full"><div><h2>How full repository sync works</h2><div class="flow"><span>1<strong>Queue profile</strong><small>HTTP returns 202</small></span><b>→</b><span>2<strong>Hydrate GitHub</strong><small>Profile + repos</small></span><b>→</b><span>3<strong>Read activity</strong><small>30-day commits</small></span><b>→</b><span>4<strong>Persist</strong><small>PostgreSQL</small></span><b>→</b><span>5<strong>Rank</strong><small>Redis ZSET</small></span></div></div></section></div>
@code { private bool testing; private ConnectionStatus? status; private async Task Test(){testing=true; status=await Http.PostAsync("api/settings/github/test",null).ContinueWith(async x=>await x.Result.Content.ReadFromJsonAsync<ConnectionStatus>()).Unwrap(); testing=false;} }
