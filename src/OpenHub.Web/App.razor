<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData"><RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" /><FocusOnNavigate RouteData="@routeData" Selector="h1" /></Found>
    <NotFound><LayoutView Layout="@typeof(Layout.MainLayout)"><div class="empty"><h1>Page not found</h1><a href="/">Return to dashboard</a></div></LayoutView></NotFound>
</Router>
